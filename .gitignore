# Phonos v3 .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
*.db
*.db-journal
*.db-wal
*.db-shm

# 环境变量
.env
.env.local
.env.*.local
.env.runtime
.env.bak

# 模型文件（全部从云盘下载，不入仓库）
models/
models_upload/

# 音频缓存
tts_cache/
*.wav
*.mp3
*.webm
*.ogg

# 临时文件
*.tmp
*.bak
*.swp
*~

# IDE
.vscode/
.idea/
*.code-workspace

# OS
.DS_Store
Thumbs.db

# 前端
node_modules/
frontend-v3/dist/
frontend-v3/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 日志
logs/
*.log

# Docker
docker-compose.override.yml

# 测试结果（截图等）
test_results/

# 校准数据
bench/calibration_set/audio/
bench/results/

# nltk_data（从云盘下载）
nltk_data/
