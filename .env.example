# ============================================================
# Phonos v3 配置示例
# 复制为 .env 并按需修改
# ============================================================

# ---------- 基础 ----------
ENV=local
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=console

# ---------- 安全 ----------
# 逗号分隔的允许来源
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173
SECRET_KEY=phonos-dev-secret-change-me-in-production
BCRYPT_ROUNDS=12

# ---------- 数据库 ----------
# 本地默认 SQLite
DATABASE_URL=sqlite:///backend/phonos_main.db
# 多用户/学校版：
# DATABASE_URL=postgresql://user:pass@localhost:5432/phonos

# ---------- 模型路径 ----------
MODELS_DIR=models
HUPER_MODEL_PATH=
HUPER_PROVIDER=auto
HUPER_INTRA_OP_THREADS=4
HUPER_INTER_OP_THREADS=0
HUPER_MODEL_MODE=balanced

# ---------- VAD ----------
VAD_MODEL_PATH=
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_DURATION_MS=250
VAD_MIN_SILENCE_DURATION_MS=100
VAD_SPEECH_PAD_MS=30

# ---------- Whisper ASR ----------
WHISPER_ENABLED=false
WHISPER_MODEL_SIZE=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=auto
WHISPER_CPU_THREADS=4

# ---------- 强制对齐 ----------
FORCED_ALIGNER=ctc_segmentation

# ---------- G2P ----------
G2P_USE_PHONEMIZER=false
G2P_CUSTOM_DICT_PATH=backend/shanghai_corpus/custom_dict.json

# ---------- 商业 API（默认全关闭）----------
ENABLE_AZURE_PRONUNCIATION=false
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia

ENABLE_XFYUN_ISE=false
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=

ENABLE_YOUDAO=false
YOUDAO_APP_KEY=
YOUDAO_APP_SECRET=

# ---------- 隐私 ----------
UPLOAD_USER_AUDIO=false
ALLOW_ONLINE_DICT=true
ALLOW_ONLINE_TRANSLATE=true
ALLOW_ONLINE_TTS=true

# ---------- 性能 ----------
MAX_AUDIO_DURATION_SEC=60
BATCH_INFERENCE=false
REQUEST_TIMEOUT_SEC=60

# ---------- 评分权重 ----------
SCORING_WEIGHTS_PRON=0.45
SCORING_WEIGHTS_COMP=0.20
SCORING_WEIGHTS_FLU=0.15
SCORING_WEIGHTS_PROSODY=0.10
SCORING_WEIGHTS_QUALITY=0.10

# ---------- FSRS ----------
FSRS_DESIRED_RETENTION=0.9
FSRS_NEW_PER_DAY=5
FSRS_FIT_INTERVAL=30
FSRS_FIT_MIN_REVIEWS=30

# ---------- 上海考试 ----------
SHANGHAI_EXAM_STRICT_TIMING=true
SHANGHAI_EXAM_AUTO_SUBMIT=true
SHANGHAI_EXAM_RECORD_AUDIO_CHECK=true

# ---------- 健康检查 ----------
HEALTH_CHECK_DB=true
HEALTH_CHECK_DISK=true
HEALTH_CHECK_MIN_DISK_GB=1.0
