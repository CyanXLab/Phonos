# ============================================================
# Phonos v3.2 配置示例
# 复制为 .env 并按需修改
# 所有配置都可通过网页 /api/config/ 修改（持久化到 .env.runtime）
# ============================================================

# ---------- 基础 ----------
ENV=local
DEBUG=true
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=console

# ---------- 安全 ----------
CORS_ALLOWED_ORIGINS_STR=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000
SECRET_KEY=phonos-dev-secret-change-me-in-production
BCRYPT_ROUNDS=12

# ---------- 模型路径（全部本地开源模型）----------
MODELS_DIR=models
# HuBERT-large INT8（音素识别，约 347MB）
HUPER_MODEL_PATH=models/huper_onnx_int8_dynamic/model_quantized.onnx
HUPER_PROVIDER=cpu
HUPER_INTRA_OP_THREADS=4
HUPER_MODEL_MODE=balanced

# silero-vad（语音活动检测，319KB）
VAD_MODEL_PATH=models/silero_vad.onnx

# faster-whisper（听力 ASR，141MB base / 480MB small）
WHISPER_ENABLED=false
WHISPER_MODEL_SIZE=base
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu

# opus-mt-en-zh（英译中，298MB）- 自动从 models/opus_mt_en_zh 加载

# 强制对齐（CTC segmentation，纯 Python 无依赖）
FORCED_ALIGNER=ctc_segmentation

# G2P
G2P_CUSTOM_DICT_PATH=backend/shanghai_corpus/custom_dict.json

# ---------- LLM 评分（默认 ModelScope 云端）----------
# ModelScope API（用户需自行注册 key）
MODELSCOPE_API_KEY=
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1
MODELSCOPE_MODEL=Qwen/Qwen3.5-122B-A10B
# 或本地 llama.cpp（可选）
LLAMA_CPP_URL=http://127.0.0.1:8080/v1
LLM_ENABLED=true

# ---------- 商业 API（默认全关闭，本地优先）----------
ENABLE_AZURE_PRONUNCIATION=false
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia

ENABLE_XFYUN_ISE=false
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=

ENABLE_YOUDAO=false
YOUDAO_APP_KEY=
YOUDAO_APP_SECRET=

# ---------- 隐私 ----------
UPLOAD_USER_AUDIO=false
ALLOW_ONLINE_DICT=true
ALLOW_ONLINE_TRANSLATE=true
ALLOW_ONLINE_TTS=true

# ---------- 性能 ----------
MAX_AUDIO_DURATION_SEC=60
BATCH_INFERENCE=false
REQUEST_TIMEOUT_SEC=60

# ---------- 评分权重 ----------
SCORING_WEIGHTS_PRON=0.45
SCORING_WEIGHTS_COMP=0.20
SCORING_WEIGHTS_FLU=0.15
SCORING_WEIGHTS_PROSODY=0.10
SCORING_WEIGHTS_QUALITY=0.10

# ---------- FSRS ----------
FSRS_DESIRED_RETENTION=0.9
FSRS_NEW_PER_DAY=5
FSRS_FIT_INTERVAL=30
FSRS_FIT_MIN_REVIEWS=30

# ---------- 上海考试 ----------
SHANGHAI_EXAM_STRICT_TIMING=true
SHANGHAI_EXAM_AUTO_SUBMIT=true
SHANGHAI_EXAM_RECORD_AUDIO_CHECK=true

# ---------- 健康检查 ----------
HEALTH_CHECK_DB=true
HEALTH_CHECK_DISK=true
HEALTH_CHECK_MIN_DISK_GB=1.0
